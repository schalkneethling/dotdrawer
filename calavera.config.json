{
  "$schema": "https://calavera.schalkneethling.com/calavera.config.schema.json",
  "version": 1,
  "profile": "minimal",
  "packageManager": "npm",
  "integrations": [
    "github-repository-controls"
  ],
  "integrationOptions": {
    "github-repository-controls": {
      "repository": "schalkneethling/dotdrawer",
      "defaultBranch": "main",
      "requireCodeqlResults": true,
      "requiredChecks": [
        "test"
      ],
      "mergeMethods": [
        "squash"
      ],
      "dependabotEcosystems": [
        "github-actions"
      ],
      "codeqlLanguages": [
        "actions",
        "javascript-typescript",
        "swift"
      ]
    }
  },
  "scripts": {}
}
